# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development            # development | production | test
PORT=3000
HOST=0.0.0.0                 # production defaults to 127.0.0.1; never use a wildcard in production
API_BASE_URL=http://localhost:3000
# Explicitly opt into HTTP-only IP deployments. Keep false when HTTPS is available.
ALLOW_INSECURE_HTTP=false
COOKIE_SECURE=true
TRUST_PROXY=1

# ── Database (MySQL / MariaDB) ───────────────────────────────────────────────
DATABASE_URL=mysql://kkn:kkn_dev_pw@127.0.0.1:3306/kanyakumari_news
# Used by the jest integration/contract suites (must be a separate database)
TEST_DATABASE_URL=mysql://kkn:kkn_dev_pw@127.0.0.1:3306/kanyakumari_news_test

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-64-random-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_READER_SECRET=change-me-separate-reader-secret
JWT_READER_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_DAYS=14
REFRESH_COOKIE_NAME=kkn_refresh
# Secret used to HMAC-hash client IPs stored in article_views / activity_logs
IP_HASH_SECRET=change-me-ip-hash-secret

# ── CORS origins (comma separated) ───────────────────────────────────────────
ADMIN_FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_FRONTEND_ORIGIN=http://localhost:3000
EXTRA_CORS_ORIGINS=

# ── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
# Public base URL where /uploads is served (Nginx or Express static)
PUBLIC_UPLOAD_URL=http://localhost:3000/uploads
MAX_IMAGE_UPLOAD_MB=5
MAX_PDF_UPLOAD_MB=20
# Thumbnail (card) derivative width in px
THUMBNAIL_WIDTH=640

# ── Mail (nodemailer) ────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kanyakumari Today <no-reply@kanyakumaritoday.com>"
CONTACT_RECIPIENT=newsroom@example.com

# ── OTP ──────────────────────────────────────────────────────────────────────
# console | dev (development/test only) | disabled (production fail-closed mode)
OTP_PROVIDER=console
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ── Weather provider ─────────────────────────────────────────────────────────
# e.g. openweathermap
WEATHER_PROVIDER=openweathermap
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org
WEATHER_CITY_LAT=8.0883
WEATHER_CITY_LON=77.5399
WEATHER_CACHE_TTL_SECONDS=600

# ── Market / commodity provider ──────────────────────────────────────────────
MARKET_PROVIDER=
MARKET_API_KEY=
MARKET_API_BASE_URL=
MARKET_CACHE_TTL_SECONDS=600

# ── Scheduler ────────────────────────────────────────────────────────────────
# Set false in unit-test processes to avoid stray cron ticks
ENABLE_SCHEDULER=true

# ── Seed (prisma/seed.js) ────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@kanyakumaritoday.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin
